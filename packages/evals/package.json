{
	"name": "@earendil-works/pi-evals",
	"version": "1.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"clean": "shx rm -rf .eval",
		"eval": "npm run eval:host && npm run eval:docs --",
		"eval:host": "vitest run --config vitest.evals.config.ts --project host",
		"eval:docs": "node --experimental-strip-types src/cli.ts",
		"eval:middlemanager:dataset": "node --experimental-strip-types src/middlemanager-swebench-lite.ts",
		"eval:middlemanager:plan": "node --experimental-strip-types src/middlemanager-plan.ts",
		"eval:middlemanager:run": "node --experimental-strip-types src/middlemanager-run.ts",
		"eval:middlemanager:official": "node --experimental-strip-types src/middlemanager-swebench-evaluator.ts",
		"eval:middlemanager:report": "node --experimental-strip-types src/middlemanager-report.ts",
		"test": "vitest run --config vitest.test.config.ts"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "^1.1.0",
		"@earendil-works/pi-coding-agent": "^1.1.0",
		"@types/node": "22.19.19",
		"@vitest-evals/core": "0.15.0",
		"autoevals": "0.3.0",
		"hyparquet": "1.31.2",
		"hyparquet-compressors": "1.1.2",
		"shx": "0.3.4",
		"vitest": "4.1.11",
		"vitest-evals": "0.15.0"
	}
}
