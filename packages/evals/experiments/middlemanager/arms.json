{
	"schemaVersion": 2,
	"benchmark": {
		"id": "swe-bench-lite",
		"dataset": "princeton-nlp/SWE-bench_Lite",
		"revision": "6ec7bb89b9342f664a54a6e0a6ea6501d3437cc2",
		"config": "default",
		"split": "test",
		"expectedInstances": 300
	},
	"featureExposure": {
		"task_difficulty": "runs during task intake when a classifier is configured",
		"memory_selection": "acts only when repository memory files are preloaded",
		"bash_guardrails": "acts on bash or PowerShell tool calls",
		"edit_alignment": "acts on edit or write tool calls",
		"goal_adherence": "acts on tool calls and task settlement",
		"bounded_autopilot": "acts only when the agent calls middlemanager_choose",
		"visual_review": "not exercisable: SWE-bench Lite supplies no images"
	},
	"arms": [
		{"id": "pi-no-extensions", "kind": "baseline", "features": []},
		{"id": "middlemanager-add-task-difficulty", "kind": "middlemanager", "features": ["task_difficulty"], "shadow": false},
		{"id": "middlemanager-add-memory-selection", "kind": "middlemanager", "features": ["memory_selection"], "shadow": false},
		{"id": "middlemanager-add-bash-guardrails", "kind": "middlemanager", "features": ["bash_guardrails"], "shadow": false},
		{"id": "middlemanager-add-edit-alignment", "kind": "middlemanager", "features": ["edit_alignment"], "shadow": false},
		{"id": "middlemanager-add-goal-adherence", "kind": "middlemanager", "features": ["goal_adherence"], "shadow": false},
		{"id": "middlemanager-add-bounded-autopilot", "kind": "middlemanager", "features": ["bounded_autopilot"], "shadow": false},
		{"id": "middlemanager-add-visual-review", "kind": "middlemanager", "features": ["visual_review"], "shadow": false},
		{
			"id": "middlemanager-full",
			"kind": "middlemanager",
			"features": [
				"task_difficulty",
				"memory_selection",
				"bash_guardrails",
				"edit_alignment",
				"goal_adherence",
				"bounded_autopilot",
				"visual_review"
			],
			"shadow": false
		}
	]
}